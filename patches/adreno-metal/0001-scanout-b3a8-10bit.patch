+; scanout_b3a8: XRGB2101010 (R 29:20, G 19:10, B 9:0) rows to the scanout's BGRA rows. The compositor writes SDR into the middle of the
+; range (black 384, white 894, slope one half), the same as the driver's CPU path:
+;   level(v) = v <= 384 ? 0 : min((v - 384) >> 1, 255)
+; stored as BGRA with alpha 0xff, exactly what native_legacy_b3a8_level10() stores.
+;   kernel void scanout_b3a8(device const uint *src [[buffer(0)]], device uint *dst [[buffer(1)]], constant uint4 &p [[buffer(3)]],
+;                            uint2 gid [[thread_position_in_grid]])
+; p: width, height, source row pitch in words, destination row pitch in words.
+define void @scanout_b3a8(ptr addrspace(1) noundef readonly "air-buffer-no-alias" %src, ptr addrspace(1) noundef "air-buffer-no-alias" %dst, ptr addrspace(2) noundef readonly align 16 dereferenceable(16) "air-buffer-no-alias" %p, <2 x i32> noundef %gid) local_unnamed_addr #0 {
+entry:
+  %w = load i32, ptr addrspace(2) %p, align 16
+  %ph = getelementptr inbounds i32, ptr addrspace(2) %p, i64 1
+  %h = load i32, ptr addrspace(2) %ph, align 4
+  %pss = getelementptr inbounds i32, ptr addrspace(2) %p, i64 2
+  %ss = load i32, ptr addrspace(2) %pss, align 8
+  %pds = getelementptr inbounds i32, ptr addrspace(2) %p, i64 3
+  %ds = load i32, ptr addrspace(2) %pds, align 4
+  %x = extractelement <2 x i32> %gid, i64 0
+  %y = extractelement <2 x i32> %gid, i64 1
+  %inx = icmp ult i32 %x, %w
+  %iny = icmp ult i32 %y, %h
+  %in = and i1 %inx, %iny
+  br i1 %in, label %body, label %done
+
+body:
+  %x64 = zext i32 %x to i64
+  %y64 = zext i32 %y to i64
+  %ss64 = zext i32 %ss to i64
+  %srow = mul i64 %y64, %ss64
+  %si = add i64 %srow, %x64
+  %sp = getelementptr inbounds i32, ptr addrspace(1) %src, i64 %si
+  %v = load i32, ptr addrspace(1) %sp, align 4
+  %rv = lshr i32 %v, 20
+  %r = and i32 %rv, 1023
+  %gv = lshr i32 %v, 10
+  %g = and i32 %gv, 1023
+  %b = and i32 %v, 1023
+  %rblack = icmp ule i32 %r, 384
+  %rs0 = sub i32 %r, 384
+  %rt = select i1 %rblack, i32 0, i32 %rs0
+  %rs1 = lshr i32 %rt, 1
+  %rover = icmp ugt i32 %rs1, 255
+  %rl = select i1 %rover, i32 255, i32 %rs1
+  %gblack = icmp ule i32 %g, 384
+  %gs0 = sub i32 %g, 384
+  %gt = select i1 %gblack, i32 0, i32 %gs0
+  %gs1 = lshr i32 %gt, 1
+  %gover = icmp ugt i32 %gs1, 255
+  %gl = select i1 %gover, i32 255, i32 %gs1
+  %bblack = icmp ule i32 %b, 384
+  %bs0 = sub i32 %b, 384
+  %bt = select i1 %bblack, i32 0, i32 %bs0
+  %bs1 = lshr i32 %bt, 1
+  %bover = icmp ugt i32 %bs1, 255
+  %bl = select i1 %bover, i32 255, i32 %bs1
+  %rshift = shl i32 %rl, 16
+  %gshift = shl i32 %gl, 8
+  %rg = or i32 %rshift, %gshift
+  %rgb = or i32 %rg, %bl
+  %px = or i32 %rgb, -16777216
+  %ds64 = zext i32 %ds to i64
+  %drow = mul i64 %y64, %ds64
+  %di = add i64 %drow, %x64
+  %dp = getelementptr inbounds i32, ptr addrspace(1) %dst, i64 %di
+  store i32 %px, ptr addrspace(1) %dp, align 4
+  br label %done
+
+done:
+  ret void
+}

diff --git a/NativeTurnipWatchdog.h b/NativeTurnipWatchdog.h
new file mode 100644
--- /dev/null
+++ b/NativeTurnipWatchdog.h
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: MIT
+// Shared real-time watchdog policy for the shipping Turnip smoke test and its host regression.
+#pragma once
+
+#include <chrono>
+#include <cstddef>
+
+namespace turnip::watchdog {
+
+using Clock = std::chrono::steady_clock;
+inline constexpr unsigned kCheckpointsSeconds[] = {15, 45, 90};
+inline constexpr auto kPollInterval = std::chrono::milliseconds(100);
+
+class Schedule {
+public:
+    bool due(Clock::time_point started, Clock::time_point now) const {
+        return next_ < sizeof kCheckpointsSeconds / sizeof kCheckpointsSeconds[0] &&
+            now - started >= std::chrono::seconds(kCheckpointsSeconds[next_]);
+    }
+
+    unsigned nextCheckpointSeconds() const {
+        return next_ < sizeof kCheckpointsSeconds / sizeof kCheckpointsSeconds[0] ? kCheckpointsSeconds[next_] : 0;
+    }
+
+    bool complete() const {
+        return next_ >= sizeof kCheckpointsSeconds / sizeof kCheckpointsSeconds[0];
+    }
+
+    // One poll consumes at most one checkpoint. A late poll therefore reports
+    // each overdue checkpoint exactly once and in order on subsequent polls.
+    template <typename Done, typename Sample>
+    bool poll(Clock::time_point started, Clock::time_point now, Done &&done, Sample &&sample) {
+        if (done() || !due(started, now)) return false;
+        sample(nextCheckpointSeconds());
+        ++next_;
+        return true;
+    }
+
+private:
+    std::size_t next_ = 0;
+};
+
+}  // namespace turnip::watchdog

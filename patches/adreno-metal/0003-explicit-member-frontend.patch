++fn device() -> Device {
++    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
++        .join("../metal2vulkan-validation/profiles/moltenvk-m3.json");
++    let text = std::fs::read_to_string(path).expect("profile");
++    let mut desc = DeviceDescription::from_khronos_json(&text, None).expect("description");
++    desc.features.insert(VkFeature::RobustBufferAccess);
++    Device::new(desc, DevicePolicy::default()).expect("device")
++}
++
++fn tag(out: &mut Vec<u8>, fourcc: &[u8; 4], bytes: &[u8]) {
++    out.extend_from_slice(fourcc);
++    out.extend_from_slice(&(bytes.len() as u16).to_le_bytes());
++    out.extend_from_slice(bytes);
++}
++
++fn cstr(s: &str) -> Vec<u8> {
++    let mut v = s.as_bytes().to_vec();
++    v.push(0);
++    v
++}
++
++use metal2vulkan_devtools::metallib::wrap;
++
++struct FnSpec {
++    name: Option<String>,
++    alias: Option<(String, String)>,
++    bitcode: Vec<u8>,
++    /// Container `TYPE`. `2` is a kernel, which is what the synthetic AIR declares.
++    type_code: u8,
++    extra: Vec<([u8; 4], Vec<u8>)>,
++}
++
++fn build(functions: &[FnSpec]) -> Vec<u8> {
++    let mut public = Vec::new();
++    let mut private = Vec::new();
++    let mut bitcode = Vec::new();
++    let mut entries = Vec::new();
++    for f in functions {
++        let mut list = b"ENDT".to_vec();
++        let mut md = (list.len() as u32).to_le_bytes().to_vec();
++        md.append(&mut list);
++        let (pub_at, priv_at) = (public.len(), private.len());
++        public.extend(md.clone());
++        private.extend(md);
++        let bc_at = bitcode.len();
++        bitcode.extend_from_slice(&f.bitcode);
++        let mut tags = Vec::new();
++        if let Some(name) = &f.name {
++            tag(&mut tags, b"NAME", &cstr(name));
++        }
++        if let Some((public_name, target)) = &f.alias {
++            tag(
++                &mut tags,
++                b"ALIS",
++                &[cstr(public_name), cstr(target)].concat(),
++            );
++        }
++        tag(&mut tags, b"TYPE", &[f.type_code]);
++        tag(&mut tags, b"HASH", &sha256(&f.bitcode));
++        tag(&mut tags, b"MDSZ", &(f.bitcode.len() as u64).to_le_bytes());
++        let mut offt = Vec::new();
++        for v in [pub_at, priv_at, bc_at] {
++            offt.extend_from_slice(&(v as u64).to_le_bytes());
++        }
++        tag(&mut tags, b"OFFT", &offt);
++        tag(&mut tags, b"VERS", &[2, 0, 8, 0, 4, 0, 0, 0]);
++        for (fourcc, bytes) in &f.extra {
++            tag(&mut tags, fourcc, bytes);
++        }
++        tags.extend_from_slice(b"ENDT");
++        let mut entry = ((tags.len() + 4) as u32).to_le_bytes().to_vec();
++        entry.extend(tags);
++        entries.push(entry);
++    }
++    let entries_len: usize = entries.iter().map(Vec::len).sum();
++    let list_off = 0x58usize;
++    let pub_off = list_off + 4 + entries_len + 4;
++    let priv_off = pub_off + public.len();
++    let bc_off = priv_off + private.len();
++    let file_size = bc_off + bitcode.len();
++    let mut out = Vec::new();
++    out.extend_from_slice(b"MTLB");
++    out.extend_from_slice(&0x8001u16.to_le_bytes());
++    out.extend_from_slice(&2u16.to_le_bytes());
++    out.extend_from_slice(&9u16.to_le_bytes());
++    out.push(0);
++    out.push(0x81);
++    out.extend_from_slice(&26u16.to_le_bytes());
++    out.extend_from_slice(&0u16.to_le_bytes());
++    for v in [
++        file_size,
++        list_off,
++        entries_len,
++        pub_off,
++        public.len(),
++        priv_off,
++        private.len(),
++        bc_off,
++        bitcode.len(),
++    ] {
++        out.extend_from_slice(&(v as u64).to_le_bytes());
++    }
++    out.extend_from_slice(&(functions.len() as u32).to_le_bytes());
++    for entry in entries {
++        out.extend(entry);
++    }
++    out.extend_from_slice(b"ENDT");
++    out.extend(public);
++    out.extend(private);
++    out.extend(bitcode);
++    out
++}

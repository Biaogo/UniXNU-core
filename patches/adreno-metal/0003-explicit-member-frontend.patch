++fn macho(payload: &[u8], cputype: u32, file_type: u32) -> Vec<u8> {
++    const HEADER: usize = 32;
++    const SEGMENT: usize = 72;
++    const SECTION: usize = 80;
++    const SECTION_OFFSET: usize = 256;
++    let mut bytes = vec![0u8; SECTION_OFFSET];
++    bytes[..4].copy_from_slice(&[0xCF, 0xFA, 0xED, 0xFE]);
++    bytes[4..8].copy_from_slice(&cputype.to_le_bytes());
++    bytes[12..16].copy_from_slice(&file_type.to_le_bytes());
++    bytes[16..20].copy_from_slice(&1u32.to_le_bytes());
++    bytes[20..24].copy_from_slice(&((SEGMENT + SECTION) as u32).to_le_bytes());
++    bytes[32..36].copy_from_slice(&0x19u32.to_le_bytes());
++    bytes[36..40].copy_from_slice(&((SEGMENT + SECTION) as u32).to_le_bytes());
++    bytes[40..46].copy_from_slice(b"__TEXT");
++    let file_size = (SECTION_OFFSET + payload.len()) as u64;
++    bytes[80..88].copy_from_slice(&file_size.to_le_bytes());
++    bytes[96..100].copy_from_slice(&1u32.to_le_bytes());
++    let section = HEADER + SEGMENT;
++    bytes[section..section + 10].copy_from_slice(b"__metallib");
++    bytes[section + 16..section + 22].copy_from_slice(b"__TEXT");
++    bytes[section + 40..section + 48].copy_from_slice(&(payload.len() as u64).to_le_bytes());
++    bytes[section + 48..section + 52].copy_from_slice(&(SECTION_OFFSET as u32).to_le_bytes());
++    bytes.extend_from_slice(payload);
++    bytes
++}

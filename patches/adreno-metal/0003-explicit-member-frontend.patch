++fn air(distinct: bool) -> Vec<u8> {
++    let body = if distinct {
++        "  %dead = add i32 1, 2\n  ret void\n"
++    } else {
++        "  ret void\n"
++    };
++    let text = format!(
++        r#"target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-v512:512:512-v1024:1024:1024-n8:16:32"
++target triple = "air64_v28-apple-macosx26.0.0"
++define void @alias_source() local_unnamed_addr {{
++entry:
++{body}}}
++!air.kernel = !{{!0}}
++!air.version = !{{!1}}
++!air.language_version = !{{!2}}
++!0 = !{{void ()* @alias_source, !3, !3}}
++!1 = !{{i32 2, i32 8, i32 0}}
++!2 = !{{!"Metal", i32 4, i32 0, i32 0}}
++!3 = !{{}}
++"#
++    );
++    metal2vulkan_devtools::llvm_assemble_text(&text).expect("synthetic AIR assembles")
++}
++
++fn named(bitcode: Vec<u8>, extra: Vec<([u8; 4], Vec<u8>)>) -> FnSpec {
++    FnSpec {
++        name: Some("alias_source".to_owned()),
++        alias: None,
++        bitcode,
++        type_code: 2,
++        extra,
++    }
++}
++
++fn spci_library(spci: Option<&[u8]>) -> Library {
++    let mut extra = Vec::new();
++    if let Some(bytes) = spci {
++        extra.push((*b"SPCI", bytes.to_vec()));
++    }
++    Library::parse(&build(&[named(wrap(&air(false)), extra)])).expect("NAME metallib")
++}
++
++fn descriptor(spci: Option<&[u8]>) -> FunctionDescriptor {
++    let library = spci_library(spci);
++    FunctionDescriptor::new(library.function("alias_source").expect("function"))
++}
++
++fn hex(bytes: &[u8]) -> String {
++    bytes.iter().map(|b| format!("{b:02x}")).collect()
++}
++
++fn assert_specialization(result: Result<impl std::fmt::Debug, crate::error::Error>) {
++    match result {
++        Err(crate::error::Error::Unsupported(refusal))
++            if refusal.feature == Feature::MetallibSpecialization => {}
++        other => panic!("SPCI must stay a typed MetallibSpecialization refusal: {other:?}"),
++    }
++}

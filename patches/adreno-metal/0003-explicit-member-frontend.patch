+/// Explicit file-order member of a multi-member GPU Mach-O.
+///
+/// `file_order` is [`metal2vulkan::library::MachOCollection`]'s file-order index, not a note index,
+/// a function index, or a byte offset. Zero is that index, not a default member. The digests are 32
+/// raw SHA-256 bytes, not hex text. `bytes` is borrowed for the call; the handle keeps its own copy.
+/// The caller passes the true length and releases the handle once. A failure returns null and leaves
+/// a reason in `nmb_last_error`. A success does not clear a previous reason. This is not automatic
+/// selection: [`nmb_library_new`] still refuses a multi-member library, and this function does not
+/// read note order.
+///
+/// # Safety
+/// `bytes` holds `length` bytes when it is non-null and `length` is non-zero. Each digest, when
+/// non-null, addresses 32 readable bytes; alignment is not required.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn nmb_library_new_member(
+    device: *mut NmbDevice,
+    bytes: *const c_void,
+    length: usize,
+    file_order: u32,
+    outer_sha256: *const u8,
+    member_sha256: *const u8,
+) -> *mut NmbLibrary {
+    guard(std::ptr::null_mut(), || {
+        if device.is_null() {
+            return Err("null handle".into());
+        }
+        if bytes.is_null() || length == 0 {
+            return Err("no library bytes".into());
+        }
+        if isize::try_from(length).is_err() {
+            return Err("library length exceeds isize::MAX".into());
+        }
+        if outer_sha256.is_null() || member_sha256.is_null() {
+            return Err("null digest".into());
+        }
+        let device = &get(device)?.0;
+        // SAFETY: length fits `isize::MAX` and the caller owns `length` bytes. The slice is the
+        // original outer, not an AIR slice: the outer digest is over these bytes.
+        let bytes = unsafe { std::slice::from_raw_parts(bytes as *const u8, length) };
+        let mut outer = [0u8; 32];
+        let mut member = [0u8; 32];
+        // SAFETY: each digest addresses 32 bytes. The copy does not require alignment.
+        unsafe {
+            std::ptr::copy_nonoverlapping(outer_sha256, outer.as_mut_ptr(), 32);
+            std::ptr::copy_nonoverlapping(member_sha256, member.as_mut_ptr(), 32);
+        }
+        let identity = metal2vulkan::library::MemberIdentity::new(outer, member);
+        let selected = metal2vulkan::library::MachOCollection::parse(bytes)
+            .and_then(|collection| collection.select(file_order, &identity))
+            .map_err(e("member"))?;
+        let library = device.new_library_with_compile_library(selected.library().clone());
+        let names = library.function_names();
+        Ok(boxed(NmbLibrary(library, names)))
+    })
+}
+
 #[unsafe(no_mangle)]
 pub extern "C" fn nmb_library_release(library: *mut NmbLibrary) {
     release(library)

++/// Where the parsed MTLB was borrowed from in the caller's input.
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub struct MetallibOrigin<'a> {
++    /// The complete bytes the caller passed to [`super::parse`].
++    pub outer: &'a [u8],
++    /// Which outer form contains the MTLB.
++    pub kind: MetallibOriginKind,
++    /// The MTLB's offset from `outer`.
++    pub offset: u64,
++    /// The MTLB's header-declared `file_size`.
++    pub size: u64,
++}
++
++/// The outer container a parsed MTLB came from.
++#[non_exhaustive]
++#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
++pub enum MetallibOriginKind {
++    /// The input began with `MTLB`.
++    Metallib,
++    /// The input was a universal metallib and this is its AIR slice.
++    UniversalAirSlice,
++    /// The input was a little-endian Mach-O and this is its unique `__TEXT,__metallib` MTLB.
++    MachO,
++}
++
++/// An offset and size relative to a named container base.
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub struct RelativeRange {
++    /// The start offset.
++    pub offset: u64,
++    /// The number of bytes.
++    pub size: u64,
++}
++
++/// One raw tag in a specialization script group.
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub struct SpecializationScriptTag<'a> {
++    /// The four-character tag code.
++    pub fourcc: [u8; 4],
++    /// The tag's payload. For `SBUF`, `SBUZ`, and `RBUZ` this excludes the token's `u32` size.
++    pub bytes: &'a [u8],
++}
++
++/// An `SLST` script group.
++#[derive(Clone, Debug, PartialEq, Eq)]
++pub struct SpecializationScriptGroup<'a> {

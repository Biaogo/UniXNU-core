++++ b/crates/metal2vulkan/src/library/collection.rs
+@@ -0,0 +1,231 @@
++//! Explicit selection of one MTLB from a GPU Mach-O that holds several.
++//!
++//! [`crate::library::Library::parse`] and [`crate::library::Library::from_metallib`] still refuse
++//! that file as one library (`MachOOuter::LibraryCount`). This module does not choose a member
++//! for the caller, and it does not treat a note-table index as a file-order index.
++//!
++//! A selected library keeps the full outer bytes and their SHA-256. Its function table is only
++//! the chosen member. The member MTLB hash and range are separate fields on [`SelectedMember`].
++//! Compile re-parses that member span, so an internal binding's table index stays local to the
++//! member. Compile keys stay keyed by AIR hash: the same AIR may be reused. A selection identity
++//! includes the outer SHA-256 and is refused on a different outer.
++
++use std::ops::Range;
++
++use crate::air::container::{self, sha256, Library as Container};
++use crate::air::error::{ContainerError, InputError, InputErrorKind, Location};
++use crate::cache::Hash256;
++use crate::error::Error;
++use crate::library::function::{from_selected_member, Library};
++
++/// Outer and member SHA-256 the caller must supply. A file-order index alone is not an identity.
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub struct MemberIdentity {
++    outer_sha256: Hash256,
++    member_sha256: Hash256,
++}
++
++impl MemberIdentity {
++    /// Identity of one member of one outer. The two digests are not interchangeable.
++    pub fn new(outer_sha256: Hash256, member_sha256: Hash256) -> MemberIdentity {
++        MemberIdentity {
++            outer_sha256,
++            member_sha256,
++        }
++    }
++
++    /// SHA-256 of the full outer the caller claims.
++    pub fn outer_sha256(&self) -> &Hash256 {
++        &self.outer_sha256
++    }
++
++    /// SHA-256 of the member MTLB the caller claims.
++    pub fn member_sha256(&self) -> &Hash256 {
++        &self.member_sha256
++    }
++}
++
++#[derive(Clone, Debug, PartialEq, Eq)]
++struct MemberRecord {
++    offset: u64,
++    size: u64,
++    sha256: Hash256,
++}
++
++/// A GPU Mach-O's MTLB spans, in file order, without a selected library.
++///
++/// [`Self::note_file_order`] may name a candidate permutation. [`Self::select`] ignores it.
++/// There is no method that loads the first note record or the first span by default.
++#[derive(Clone, Debug, PartialEq, Eq)]
++pub struct MachOCollection {
++    bytes: Box<[u8]>,
++    outer_sha256: Hash256,
++    members: Vec<MemberRecord>,
++    note_file_order: Option<Vec<u32>>,
++}
++
++impl MachOCollection {
++    /// Validate one GPU Mach-O and record each MTLB span. Does not decode AIR.
++    ///
++    /// A counted dependency bundle, a nonzero tail, a truncated span, an overlapping file-backed
++    /// section, and a section outside its segment are refused. Zero padding between MTLBs is kept.
++    /// A single-MTLB Mach-O is a collection of one; [`Library::from_metallib`] remains the
++    /// single-library path and still refuses a count other than one.
++    pub fn parse(bytes: &[u8]) -> Result<MachOCollection, Error> {
++        let listed = container::gpu_macho_members(bytes)?;
++        let mut members = Vec::with_capacity(listed.members().len());
++        for member in listed.members() {
++            let start = usize::try_from(member.offset())
++                .map_err(|_| container_at(ContainerError::BadOffset, member.offset()))?;
++            let len = usize::try_from(member.size())
++                .map_err(|_| container_at(ContainerError::BadOffset, member.offset()))?;
++            let end = start
++                .checked_add(len)
++                .ok_or_else(|| container_at(ContainerError::BadOffset, member.offset()))?;
++            let slice = bytes
++                .get(start..end)
++                .ok_or_else(|| container_at(ContainerError::BadOffset, member.offset()))?;
++            members.push(MemberRecord {
++                offset: member.offset(),
++                size: member.size(),
++                sha256: sha256(slice),
++            });
++        }
++        Ok(MachOCollection {
++            bytes: bytes.into(),
++            outer_sha256: sha256(bytes),
++            members,
++            note_file_order: listed.note_file_order().map(|order| order.to_vec()),
++        })
++    }
++
++    /// SHA-256 of the full outer.
++    pub fn outer_sha256(&self) -> &Hash256 {
++        &self.outer_sha256
++    }
++
++    /// The full outer bytes. Not a selected member.
++    pub fn outer_bytes(&self) -> &[u8] {
++        &self.bytes
++    }
++
++    /// How many MTLBs are in file order.
++    pub fn len(&self) -> u32 {
++        u32::try_from(self.members.len()).unwrap_or(u32::MAX)
++    }
++
++    /// Whether the section contained no MTLB. [`parse`] refuses that file, so this is false.
++    pub fn is_empty(&self) -> bool {
++        self.members.is_empty()
++    }
++
++    /// File-order range of member `file_order`. Not a note-table index.
++    pub fn member_range(&self, file_order: u32) -> Option<Range<u64>> {
++        self.record(file_order)
++            .map(|member| member.offset..member.offset + member.size)
++    }
++
++    /// SHA-256 of the member MTLB at file order `file_order`.
++    pub fn member_sha256(&self, file_order: u32) -> Option<&Hash256> {
++        self.record(file_order).map(|member| &member.sha256)
++    }
++
++    /// Note-record order as file-order indices, if a unique candidate association was established.
++    ///
++    /// This is not a selection. [`Self::select`] does not read it. `None` is not a default member.
++    pub fn note_file_order(&self) -> Option<&[u32]> {
++        self.note_file_order.as_deref()
++    }
++
++    /// Load the file-order member whose outer and member SHA-256 the caller supplies.
++    ///
++    /// `file_order` is the index in [`Self::len`], not a note-table index and not a function index.
++    /// A digest from another outer is refused even when the member bytes match. The returned
++    /// library's bytes and content hash are this outer. Its function names are this member's only.
++    pub fn select(
++        &self,
++        file_order: u32,
++        identity: &MemberIdentity,
++    ) -> Result<SelectedMember, Error> {
++        if identity.outer_sha256 != self.outer_sha256 {
++            return Err(container_at(ContainerError::HashMismatch, 0));
++        }
++        let member = self
++            .record(file_order)
++            .ok_or_else(|| container_at(ContainerError::BadOffset, u64::from(file_order)))?;
++        if identity.member_sha256 != member.sha256 {
++            return Err(container_at(ContainerError::HashMismatch, member.offset));
++        }
++        let start = usize::try_from(member.offset)
++            .map_err(|_| container_at(ContainerError::BadOffset, member.offset))?;
++        let len = usize::try_from(member.size)
++            .map_err(|_| container_at(ContainerError::BadOffset, member.offset))?;
++        let end = start
++            .checked_add(len)
++            .ok_or_else(|| container_at(ContainerError::BadOffset, member.offset))?;
++        let slice = self
++            .bytes
++            .get(start..end)
++            .ok_or_else(|| container_at(ContainerError::BadOffset, member.offset))?;
++        let Container::Metallib(parsed) = container::parse(slice)? else {
++            return Err(container_at(ContainerError::BadMagic, member.offset));
++        };
++        let library = from_selected_member(&self.bytes, start..end, &parsed)?;
++        Ok(SelectedMember {
++            file_order,
++            range: member.offset..member.offset + member.size,
++            member_sha256: member.sha256,
++            library,
++        })
++    }
++
++    fn record(&self, file_order: u32) -> Option<&MemberRecord> {
++        usize::try_from(file_order)
++            .ok()
++            .and_then(|index| self.members.get(index))
++    }
++}
++
++/// One explicitly selected member. Not a flattened function table.
++///
++/// [`Self::library`] keeps the outer bytes and outer SHA-256. [`Self::member_sha256`] and
++/// [`Self::member_range`] are the inner MTLB. Function lookup on the library sees only this
++/// member's names.
++#[derive(Clone, Debug, PartialEq, Eq)]
++pub struct SelectedMember {
++    file_order: u32,
++    range: Range<u64>,
++    member_sha256: Hash256,
++    library: Library,
++}
++
++impl SelectedMember {
++    /// File order of this member. Not a note-table index.
++    pub fn file_order(&self) -> u32 {
++        self.file_order
++    }
++
++    /// Absolute range of the member MTLB inside the outer.
++    pub fn member_range(&self) -> Range<u64> {
++        self.range.clone()
++    }
++
++    /// SHA-256 of the member MTLB. Not [`Library::content_hash`](Library::content_hash).
++    pub fn member_sha256(&self) -> &Hash256 {
++        &self.member_sha256
++    }
++
++    /// SHA-256 of the full outer. Equal to the library content hash.
++    pub fn outer_sha256(&self) -> &Hash256 {
++        self.library.content_hash()
++    }
++
++    /// The member as a library. Bytes and content hash are the outer; names are this member's.
++    pub fn library(&self) -> &Library {
++        &self.library
++    }
++}
++
++fn container_at(kind: ContainerError, at: u64) -> Error {
++    InputError::new(InputErrorKind::Container(kind), Location::container(at)).into()
++}

++#[test]
++fn script_int_and_bool_change_the_compiled_store() {
++    let base_name = "base_store";
++    let own_name = "own_store";
++    let base = value_base(base_name);
++    let own = value_own(own_name);
++    let public = vec![(*b"CNST", cnst(&[("n", 29, 0), ("flag", 53, 1)]))];
++    let cases = [(0, false), (1, false), (0, true), (1, true)];
++    let plain = semantic_words(&compile_words(
++        Library::parse(&library(
++            &[FnRow {
++                name: own_name.to_owned(),
++                bitcode: own.clone(),
++                extra: Vec::new(),
++                public_tags: Vec::new(),
++            }],
++            &[],
++        ))
++        .expect("plain library")
++        .function(own_name)
++        .expect("plain own"),
++        FunctionConstantValues::default(),
++    ));
++    for (int_value, flag) in cases {
++        let script = airc_consts(
++            base_name,
++            &[ScriptConst::Int(0, int_value), ScriptConst::Bool(1, flag)],
++        );
++        let bytes = bind(
++            base_name,
++            own_name,
++            base.clone(),
++            own.clone(),
++            &script,
++            Vec::new(),
++            public.clone(),
++            Vec::new(),
++        );
++        let library = Library::parse(&bytes).expect("library");
++        let bound = library.function(own_name).expect("own");
++        let direct = library.function(base_name).expect("base");
++        assert_eq!(bound.info().name, own_name);
++        assert_ne!(bound.info().air_hash, direct.info().air_hash);
++        assert_eq!(bound.bitcode().expect("own bytes"), own.as_slice());
++        let from_binding = semantic_words(&compile_words(bound, FunctionConstantValues::default()));
++        let from_base = semantic_words(&compile_words(direct, values_of(int_value, flag)));
++        assert_eq!(
++            from_binding, from_base,
++            "int {int_value} bool {flag} must match base+explicit values, ignoring entry identity"
++        );
++        assert_ne!(
++            from_binding, plain,
++            "int {int_value} bool {flag} must not compile own's store of 7"
++        );
++    }
++}

++struct Flat {
++    bytes: Vec<u8>,
++}
++
++impl Flat {
++    fn new() -> Flat {
++        Flat { bytes: vec![0; 8] }
++    }
++    fn align(&mut self, alignment: usize) {
++        while self.bytes.len() % alignment != 0 {
++            self.bytes.push(0);
++        }
++    }
++    fn allocate(&mut self, size: usize, alignment: usize) -> usize {
++        self.align(alignment);
++        let at = self.bytes.len();
++        self.bytes.resize(at + size, 0);
++        at
++    }
++    fn table(&mut self, fields: &[(u16, u16)], table_size: usize) -> usize {
++        let table = self.allocate(table_size, 4);
++        let vtable_size = 4 + 2 * fields
++            .iter()
++            .map(|(id, _)| usize::from(*id) + 1)
++            .max()
++            .unwrap_or(0);
++        let vtable = self.allocate(vtable_size, 2);
++        self.i32(table, table as i32 - vtable as i32);
++        self.u16(vtable, vtable_size as u16);
++        self.u16(vtable + 2, table_size as u16);
++        for (id, offset) in fields {
++            self.u16(vtable + 4 + 2 * usize::from(*id), *offset);
++        }
++        table
++    }
++    fn string(&mut self, value: &str) -> usize {
++        let at = self.allocate(4 + value.len() + 1, 4);
++        self.u32(at, value.len() as u32);
++        self.bytes[at + 4..at + 4 + value.len()].copy_from_slice(value.as_bytes());
++        at
++    }
++    fn offsets(&mut self, count: usize) -> usize {
++        let at = self.allocate(4 + 4 * count, 4);
++        self.u32(at, count as u32);
++        at
++    }
++    fn finish(mut self, root: usize) -> Vec<u8> {
++        self.u32(0, root as u32);
++        self.bytes[4..8].copy_from_slice(b"AIRC");
++        self.bytes
++    }
++    fn u8(&mut self, at: usize, value: u8) {
++        self.bytes[at] = value;
++    }
++    fn u16(&mut self, at: usize, value: u16) {
++        self.bytes[at..at + 2].copy_from_slice(&value.to_le_bytes());
++    }
++    fn u32(&mut self, at: usize, value: u32) {
++        self.bytes[at..at + 4].copy_from_slice(&value.to_le_bytes());
++    }
++    fn i32(&mut self, at: usize, value: i32) {
++        self.u32(at, value as u32);
++    }
++    fn offset(&mut self, at: usize, target: usize) {
++        self.u32(at, (target as u32).wrapping_sub(at as u32));
++    }
++}

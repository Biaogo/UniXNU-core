++    let Some(ir_ty) = decoded.module.types().get(ty) else {
++        return false;
++    };
++    match (value_ty, ir_ty) {
++        (DataType::Int, Type::Int(32)) => len == 4,
++        (DataType::Bool, Type::Int(8)) => len == 1,
++        _ => false,
++    }

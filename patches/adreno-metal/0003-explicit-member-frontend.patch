++        Ok(SpecializationConstants::Decoded(decoded)) => {
++            (decoded.version, generator_value(decoded.generator))
++        }
++        Ok(SpecializationConstants::Unsupported(unsupported)) => (
++            unsupported.version.unwrap_or(SpecializationVersion {
++                major: u32::MAX,
++                minor: u32::MAX,
++                sub_minor: u32::MAX,
++            }),
++            unsupported
++                .generator
++                .map(generator_value)
++                .unwrap_or(u8::MAX),
++        ),
++        Err(_) | Ok(_) => (
++            SpecializationVersion {
++                major: u32::MAX,
++                minor: u32::MAX,
++                sub_minor: u32::MAX,
++            },
++            u8::MAX,
++        ),
++    };

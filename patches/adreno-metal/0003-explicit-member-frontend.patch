++    assert_eq!(libs[0].content_hash(), libs[1].content_hash());
++    assert_eq!(libs[0].install_name(), Some("libD"));
++    assert_eq!(libs[1].install_name(), Some("libD"));
++    assert_ne!(
++        libs[0].function_table_identity(),
++        libs[1].function_table_identity()
++    );
++    assert_ne!(libs[0].function_table_identity(), libs[0].content_hash());
++    let stage = Library::from_metallib(&kernel("stage", 7)).expect("stage");
++    assert_eq!(stage.function_table_identity(), stage.content_hash());
++    let plain_dynamic = Library::from_metallib(&dynamic_member("libD", 4)).expect("plain dynamic");
++    assert_eq!(
++        plain_dynamic.function_table_identity(),
++        plain_dynamic.content_hash()
++    );
++    let function = stage.function("stage").expect("function");
++    let device = real_device();
++    assert_ne!(
++        stage_key(&device, &function, &libs[0]),
++        stage_key(&device, &function, &libs[1]),
++        "same install name and outer digest shared a compile key"
++    );
++    let again = selected_dynamic("libD", &[1, 2]);
++    assert_eq!(
++        stage_key(&device, &function, &again[0]),
++        stage_key(&device, &function, &libs[0]),
++        "the same member bytes and range must keep one compile key"
++    );
++}

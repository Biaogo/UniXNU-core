++fn bind(
++    base_name: &str,
++    own_name: &str,
++    base: Vec<u8>,
++    own: Vec<u8>,
++    script: &[u8],
++    own_extra: Vec<([u8; 4], Vec<u8>)>,
++    base_public: Vec<([u8; 4], Vec<u8>)>,
++    own_public: Vec<([u8; 4], Vec<u8>)>,
++) -> Vec<u8> {
++    let mut bytes = library(
++        &[
++            FnRow {
++                name: base_name.to_owned(),
++                bitcode: base.clone(),
++                extra: Vec::new(),
++                public_tags: base_public,
++            },
++            FnRow {
++                name: own_name.to_owned(),
++                bitcode: own,
++                extra: {
++                    let mut extra = vec![(*b"SPCI", spci(sha256(&base), 4))];
++                    extra.extend(own_extra);
++                    extra
++                },
++                public_tags: own_public,
++            },
++        ],
++        script,
++    );
++    patch_spci(&mut bytes, 4);
++    bytes
++}

++        let (ty, bytes) = match constant.value {
++            SpecializationConstantValue::Int(value) => {
++                (DataType::Int, value.to_le_bytes().to_vec())
++            }
++            SpecializationConstantValue::Bool(value) => (DataType::Bool, vec![u8::from(value)]),
++            _ => return Err(specialization_refusal()),
++        };
++        let declared = declaration.data_type.ok_or_else(specialization_refusal)?;
++        if declared != ty || !exact_width(decoded, declaration.ty, ty, bytes.len()) {
++            return Err(specialization_refusal());
++        }
++        if by_index
++            .insert(
++                u32::from(constant.index),
++                FunctionConstantValue::new(ty, bytes),
++            )
++            .is_some()
++        {
++            return Err(specialization_refusal());
++        }
++    }
++    for declaration in &decoded.abi.function_constants {
++        if !by_index.contains_key(&declaration.index) {
++            return Err(specialization_refusal());
++        }
++    }
++    Ok(FunctionConstantValues {
++        by_index,
++        by_name: BTreeMap::new(),
++    })
++}

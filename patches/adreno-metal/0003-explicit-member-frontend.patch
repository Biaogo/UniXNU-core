++    pub origin: MetallibOrigin<'a>,
++    /// The SPCI-carrying function's index in the metallib function table.
++    pub function_index: usize,
++    /// The SPCI-carrying function's own verified bitcode hash.
++    pub function_hash: Hash256,
++    /// The SPCI-carrying function's own bitcode.
++    pub function_bitcode: &'a [u8],
++    /// The named base function's index in the metallib function table.

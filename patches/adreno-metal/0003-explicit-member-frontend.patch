++fn selected_dynamic(install: &str, seeds: &[u8]) -> Vec<crate::library::Library> {
++    let members: Vec<Vec<u8>> = seeds.iter().map(|seed| dynamic_member(install, *seed)).collect();
++    let mut padded = Vec::new();
++    for (index, member) in members.iter().enumerate() {
++        if index != 0 {
++            padded.extend_from_slice(&[0, 0, 0, 0]);
++        }
++        padded.extend_from_slice(member);
++    }
++    let collection = MachOCollection::parse(&one_section(&padded, None)).expect("outer");
++    (0..seeds.len())
++        .map(|order| {
++            let order = order as u32;
++            let identity = identity_for(&collection, order);
++            collection
++                .select(order, &identity)
++                .expect("select")
++                .library()
++                .clone()
++        })
++        .collect()
++}
++
++fn one_section(payload: &[u8], segment_size: Option<u64>) -> Vec<u8> {
++    let payload_at = 256usize;
++    let size = (payload_at + payload.len()) as u64;
++    macho(
++        &[Sec {
++            name: b"__metallib",
++            seg: b"__TEXT",
++            offset: payload_at as u32,
++            size: payload.len() as u64,
++        }],
++        segment_size.unwrap_or(size),
++        payload_at,
++        payload,
++    )
++}
++
++fn container_kind(err: &Error) -> Option<ContainerError> {
++    match err {
++        Error::InvalidInput(input) => match &input.kind {
++            InputErrorKind::Container(kind) => Some(kind.clone()),
++            _ => None,
++        },
++        _ => None,
++    }
++}

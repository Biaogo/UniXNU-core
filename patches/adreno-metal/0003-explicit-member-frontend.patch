++    /// `u32` size word.
++    pub relative: RelativeRange,
++    /// Every group tag, in file order. Unknown tags are retained verbatim.
++    pub tags: Vec<SpecializationScriptTag<'a>>,
++    /// The uncompressed `SBUF` script, when this group has one.
++    pub script: Option<SpecializationScript<'a>>,
++}
++
++/// An uncompressed `SBUF` script.
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub struct SpecializationScript<'a> {
++    /// The `SBUF` payload before alignment padding, relative to the `SLST` section start.
++    pub payload: RelativeRange,
++    /// The unpadded script bytes, relative to the `SLST` section start.
++    pub relative: RelativeRange,
++    /// The exact unpadded bytes. Apple's established form has a four-byte prefix followed by
++    /// `AIRC`.
++    pub bytes: &'a [u8],
++    /// The four bytes at script-relative offset 4.
++    pub identifier: [u8; 4],
++}
++
++/// The `SLST` section, kept as raw groups and typed `SBUF` scripts.
++#[derive(Clone, Debug, PartialEq, Eq)]
++pub struct SpecializationSection<'a> {

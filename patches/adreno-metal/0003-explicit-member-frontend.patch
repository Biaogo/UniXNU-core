++fn values_of(int_value: i32, flag: bool) -> FunctionConstantValues {
++    FunctionConstantValues::defaults()
++        .with_index(
++            0,
++            FunctionConstantValue::new(DataType::Int, int_value.to_le_bytes()),
++        )
++        .with_index(
++            1,
++            FunctionConstantValue::new(DataType::Bool, [u8::from(flag)]),
++        )
++}

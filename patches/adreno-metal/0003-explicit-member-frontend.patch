++fn macho(sections: &[Sec], segment_size: u64, payload_at: usize, payload: &[u8]) -> Vec<u8> {
++    let cmd_size = 72 + sections.len() * 80;
++    let mut bytes = vec![0u8; payload_at];
++    bytes[..4].copy_from_slice(&[0xCF, 0xFA, 0xED, 0xFE]);
++    bytes[4..8].copy_from_slice(&0x0100_0013u32.to_le_bytes());
++    bytes[12..16].copy_from_slice(&1u32.to_le_bytes());
++    bytes[16..20].copy_from_slice(&1u32.to_le_bytes());
++    bytes[20..24].copy_from_slice(&(cmd_size as u32).to_le_bytes());
++    bytes[32..36].copy_from_slice(&0x19u32.to_le_bytes());
++    bytes[36..40].copy_from_slice(&(cmd_size as u32).to_le_bytes());
++    write_name(&mut bytes[40..56], b"__TEXT");
++    bytes[80..88].copy_from_slice(&segment_size.to_le_bytes());
++    bytes[96..100].copy_from_slice(&(sections.len() as u32).to_le_bytes());
++    for (index, section) in sections.iter().enumerate() {
++        let at = 32 + 72 + index * 80;
++        write_name(&mut bytes[at..at + 16], section.name);
++        write_name(&mut bytes[at + 16..at + 32], section.seg);
++        bytes[at + 40..at + 48].copy_from_slice(&section.size.to_le_bytes());
++        bytes[at + 48..at + 52].copy_from_slice(&section.offset.to_le_bytes());
++    }
++    bytes.extend_from_slice(payload);
++    bytes
++}

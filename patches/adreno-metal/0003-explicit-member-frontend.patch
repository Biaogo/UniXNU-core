++//! Typed constants from an established specialization binding's AIRC script.
++//!
++//! The supported schema form is the verified reflection layout for
++//! `Air.ConstantsSpecializationScript` version 0.1.0 and `Air.Generator.NativeTranslator`.
++//! This reader covers only the six objects and two enums that form that root:
++//! `Air.ConstantsSpecializationScript`, `Air.ConstantsSpecializationDescriptor`,
++//! `Air.FunctionConstantValue`, `Air.Version`, `Air.ConstantInt`, and `Air.ConstantBool`.
++//! It is deliberately not a general FlatBuffers schema interpreter.
++//!
++//! Field IDs, inline widths, and defaults come from Apple's verified reflection schema:
++//! `version` is an inline three-u32 struct, `generator` is a u8 with default zero,
++//! `descriptor.name` and `descriptor.specialized_name` are strings,
++//! `descriptor.constant_values` is a vector of tables, each constant's `index` is a u16 with
++//! default zero, `value_type` is a u8 union discriminator with default zero, and `value` is a
++//! union offset. Integer and boolean union payloads are inline structs. The reader accepts union
++//! tags 29 (`ConstantInt`, i32) and 53 (`ConstantBool`, BOOL); every other tag is retained as
++//! unsupported rather than guessed.
++
++use std::collections::BTreeSet;
++
++use super::{
++    container_error, sha256, Hash256, MetallibOrigin, SpecializationBinding, SpecializationScript,
++};
++use crate::error::{ContainerError, Error};
++
++const AIRC_IDENTIFIER: [u8; 4] = *b"AIRC";
++const SUPPORTED_VERSION: SpecializationVersion = SpecializationVersion {
++    major: 0,
++    minor: 1,
++    sub_minor: 0,
++};
++const NATIVE_TRANSLATOR: u8 = 1;
++const CONSTANT_INT: u8 = 29;
++const CONSTANT_BOOL: u8 = 53;
++const GENERATOR_DEFAULT: u8 = 0;
++const CONSTANT_INDEX_DEFAULT: u16 = 0;
++const CONSTANT_UNION_DEFAULT: u8 = 0;
++
++const ROOT_VERSION_FIELD: u16 = 0;
++const ROOT_GENERATOR_FIELD: u16 = 1;
++const ROOT_DESCRIPTOR_FIELD: u16 = 2;
++const DESCRIPTOR_NAME_FIELD: u16 = 0;
++const DESCRIPTOR_SPECIALIZED_NAME_FIELD: u16 = 1;
++const DESCRIPTOR_CONSTANTS_FIELD: u16 = 2;
++const CONSTANT_INDEX_FIELD: u16 = 0;
++const CONSTANT_VALUE_TYPE_FIELD: u16 = 1;
++const CONSTANT_VALUE_FIELD: u16 = 2;
++
++const MAX_VECTOR_ITEMS: u32 = 100_000;
++const MAX_STRING_BYTES: u32 = 1_048_576;
++
++/// The three-component version in an AIRC specialization script.
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub struct SpecializationVersion {
++    /// The major component.
++    pub major: u32,
++    /// The minor component.
++    pub minor: u32,
++    /// The sub-minor component.
++    pub sub_minor: u32,
++}
++
++/// The generator recorded by an AIRC specialization script.
++#[non_exhaustive]
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub enum SpecializationGenerator {
++    /// `Air.Generator.NativeTranslator`, value 1.
++    NativeTranslator,
++    /// A generator value this reader does not support.
++    Unsupported(u8),
++}
++
++impl SpecializationGenerator {
++    /// The schema's stored generator value.
++    pub fn value(self) -> u8 {
++        match self {
++            SpecializationGenerator::NativeTranslator => NATIVE_TRANSLATOR,
++            SpecializationGenerator::Unsupported(value) => value,
++        }
++    }
++}
++
++/// A typed function-constant value.
++#[non_exhaustive]
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub enum SpecializationConstantValue {
++    /// `Air.ConstantInt`'s i32 payload.
++    Int(i32),
++    /// `Air.ConstantBool`'s boolean payload.
++    Bool(bool),
++}
++
++/// One AIRC function constant.
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub struct SpecializationConstant {
++    /// The AIR function-constant index (a schema u16).
++    pub index: u16,
++    /// The supported typed value.
++    pub value: SpecializationConstantValue,
++}
++
++/// A non-reversible fingerprint of a name read for cross-checking.
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub struct SpecializationNameFingerprint {
++    /// The UTF-8 byte length.
++    pub byte_length: usize,
++    /// SHA-256 of the exact UTF-8 bytes.
++    pub sha256: Hash256,
++}
++
++/// The original identities retained by an AIRC constant result.
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub struct SpecializationConstantsIdentity<'a> {
++    /// The MTLB and outer container from which the binding was borrowed.
++    pub origin: MetallibOrigin<'a>,
++    /// The SPCI-carrying function's index.
++    pub function_index: usize,
++    /// The SPCI-carrying function's verified bitcode hash.
++    pub function_hash: Hash256,
++    /// The SPCI-carrying function's own bitcode.
++    pub function_bitcode: &'a [u8],
++    /// The named base function's index.
++    pub base_function_index: usize,
++    /// The named base function's verified bitcode hash.
++    pub base_function_hash: Hash256,
++    /// The named base function's own bitcode.
++    pub base_function_bitcode: &'a [u8],
++    /// The verified base hash carried by SPCI.
++    pub base_hash: Hash256,
++    /// The raw SPCI payload retained by the binding.
++    pub spci: &'a [u8],
++    /// The SPCI payload's file offset.
++    pub spci_offset: u64,
++    /// The selected script group's index.
++    pub script_group: usize,
++    /// The group offset carried by SPCI.
++    pub script_relative_offset: u64,
++    /// The unmodified script bytes and their ranges.
++    pub script: SpecializationScript<'a>,
++    /// SHA-256 of the exact unmodified script bytes.
++    pub script_hash: Hash256,
++}
++
++/// The typed AIRC fields decoded from one established binding.
++#[derive(Clone, Debug, PartialEq, Eq)]
++pub struct DecodedSpecializationConstants<'a> {
++    /// Function, base, script, range, and hash identity.
++    pub identity: SpecializationConstantsIdentity<'a>,
++    /// The decoded script version.
++    pub version: SpecializationVersion,
++    /// The decoded generator.
++    pub generator: SpecializationGenerator,
++    /// A non-reversible fingerprint of the descriptor name.
++    pub descriptor_name: SpecializationNameFingerprint,
++    /// Whether the descriptor name equals the named base entry's `NAME`.
++    pub name_matches_base: bool,
++    /// For an alias, whether the descriptor name equals the `ALIS` source entry name.
++    pub name_matches_alias_source: Option<bool>,
++    /// The supported i32 and bool constants in script order.
++    pub constants: Vec<SpecializationConstant>,
++}
++
++/// Why an otherwise readable AIRC script is not a supported decoded form.
++#[non_exhaustive]
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub enum SpecializationConstantsUnsupportedReason {
++    /// The script's byte-four identifier is not `AIRC`.
++    UnknownIdentifier {
++        /// The identifier read from the script.
++        identifier: [u8; 4],
++    },
++    /// The script version is outside the verified 0.1.0 form.
++    UnsupportedVersion {
++        /// The version read from the script.
++        version: SpecializationVersion,
++    },
++    /// The generator is outside the verified `NativeTranslator` form.
++    UnsupportedGenerator {
++        /// The generator value read from the script.
++        value: u8,
++    },
++    /// A present root field has an ID outside the three verified schema fields.
++    UnsupportedRootField {
++        /// The present field's schema ID.
++        field_id: u16,
++    },
++    /// A constant's union discriminator is outside the supported i32 and bool forms.
++    UnsupportedUnionValue {
++        /// The constant's schema index.
++        constant_index: u16,
++        /// The union discriminator read from the constant.
++        discriminator: u8,
++    },
++    /// A `specialized_name` is present; its selection semantics are not established.
++    SpecializedNamePresent,
++    /// The descriptor name does not match the binding's named base or alias source.
++    NameMismatch {
++        /// Whether the name equaled the named base entry.
++        base_matches: bool,
++        /// For an alias, whether the name equaled its source entry.
++        alias_source_matches: Option<bool>,
++    },
++}
++
++/// An AIRC script whose fields are structurally valid but whose form is not supported.
++#[derive(Clone, Debug, PartialEq, Eq)]
++pub struct UnsupportedSpecializationConstants<'a> {
++    /// Function, base, script, range, and hash identity.
++    pub identity: SpecializationConstantsIdentity<'a>,
++    /// The version, once the root could be read.
++    pub version: Option<SpecializationVersion>,
++    /// The generator, once the root could be read.
++    pub generator: Option<SpecializationGenerator>,
++    /// A non-reversible fingerprint of the descriptor name, once it could be read.
++    pub descriptor_name: Option<SpecializationNameFingerprint>,
++    /// Whether the descriptor name matched the named base, once it could be compared.
++    pub name_matches_base: Option<bool>,
++    /// For an alias, whether the descriptor name matched its source, once comparable.
++    pub name_matches_alias_source: Option<bool>,
++    /// A non-reversible fingerprint when `specialized_name` is present.
++    pub specialized_name: Option<SpecializationNameFingerprint>,
++    /// Every supported constant decoded before or alongside the unsupported field.
++    pub constants: Vec<SpecializationConstant>,
++    /// Fixed typed reasons the script is not a decoded form.
++    pub reasons: Vec<SpecializationConstantsUnsupportedReason>,
++}
++
++/// The typed result of [`SpecializationBinding::airc_constants`].
++#[non_exhaustive]
++#[derive(Clone, Debug, PartialEq, Eq)]
++pub enum SpecializationConstants<'a> {
++    /// The complete supported AIRC form.
++    Decoded(DecodedSpecializationConstants<'a>),
++    /// A readable form retained with its supported fields and explicit unsupported reasons.
++    Unsupported(UnsupportedSpecializationConstants<'a>),
++}
++
++/// Decode one established binding without applying its constants.
++pub(super) fn decode<'a>(
++    binding: &SpecializationBinding<'a>,
++) -> Result<SpecializationConstants<'a>, Error> {
++    let identity = SpecializationConstantsIdentity {
++        origin: binding.origin,
++        function_index: binding.function_index,
++        function_hash: binding.function_hash,
++        function_bitcode: binding.function_bitcode,
++        base_function_index: binding.base_function_index,
++        base_function_hash: binding.base_function_hash,
++        base_function_bitcode: binding.base_function_bitcode,
++        base_hash: binding.base_hash,
++        spci: binding.spci,
++        spci_offset: binding.spci_offset,
++        script_group: binding.script_group,
++        script_relative_offset: binding.script_relative_offset,
++        script: binding.script,
++        script_hash: sha256(binding.script.bytes),
++    };
++    match parse_script(
++        binding.script.bytes,
++        binding.base_function_name,
++        binding.alias_source_name,
++    )? {
++        ParsedAirc::Decoded {
++            version,
++            generator,
++            descriptor_name,
++            name_matches_base,
++            name_matches_alias_source,
++            constants,
++        } => Ok(SpecializationConstants::Decoded(
++            DecodedSpecializationConstants {
++                identity,
++                version,
++                generator,
++                descriptor_name,
++                name_matches_base,
++                name_matches_alias_source,
++                constants,
++            },
++        )),
++        ParsedAirc::Unsupported {
++            version,
++            generator,
++            descriptor_name,
++            name_matches_base,
++            name_matches_alias_source,
++            specialized_name,
++            constants,
++            reasons,
++        } => Ok(SpecializationConstants::Unsupported(
++            UnsupportedSpecializationConstants {
++                identity,
++                version,
++                generator,
++                descriptor_name,
++                name_matches_base,
++                name_matches_alias_source,
++                specialized_name,
++                constants,
++                reasons,
++            },
++        )),
++    }
++}
++
++#[derive(Debug)]
++pub(super) enum ParsedAirc {
++    Decoded {
++        version: SpecializationVersion,
++        generator: SpecializationGenerator,
++        descriptor_name: SpecializationNameFingerprint,
++        name_matches_base: bool,
++        name_matches_alias_source: Option<bool>,
++        constants: Vec<SpecializationConstant>,
++    },
++    Unsupported {
++        version: Option<SpecializationVersion>,
++        generator: Option<SpecializationGenerator>,
++        descriptor_name: Option<SpecializationNameFingerprint>,
++        name_matches_base: Option<bool>,
++        name_matches_alias_source: Option<bool>,
++        specialized_name: Option<SpecializationNameFingerprint>,
++        constants: Vec<SpecializationConstant>,
++        reasons: Vec<SpecializationConstantsUnsupportedReason>,
++    },
++}
++
++pub(super) fn parse_script(
++    bytes: &[u8],
++    base_name: &str,
++    alias_source_name: Option<&str>,
++) -> Result<ParsedAirc, Error> {
++    let reader = FlatReader { bytes };
++    reader.require(0, 8)?;
++    let root_offset = usize::try_from(reader.u32(0)?).map_err(|_| reader.bad(0))?;
++    if root_offset < 8 || root_offset >= bytes.len() {
++        return Err(reader.bad(0));
++    }
++    let mut identifier = [0u8; 4];
++    identifier.copy_from_slice(reader.bytes(4, 4)?);
++    if identifier != AIRC_IDENTIFIER {
++        return Ok(ParsedAirc::Unsupported {
++            version: None,
++            generator: None,
++            descriptor_name: None,
++            name_matches_base: None,
++            name_matches_alias_source: None,
++            specialized_name: None,
++            constants: Vec::new(),
++            reasons: vec![
++                SpecializationConstantsUnsupportedReason::UnknownIdentifier { identifier },
++            ],
++        });
++    }
++
++    let root = reader.table(root_offset)?;
++    let mut reasons = Vec::new();
++    for field_id in reader.present_fields_from(root, 3)? {
++        reasons.push(SpecializationConstantsUnsupportedReason::UnsupportedRootField { field_id });
++    }
++
++    let version_position = root
++        .field(&reader, ROOT_VERSION_FIELD, 12)?
++        .ok_or_else(|| container_error(ContainerError::MissingTag, root.position as u64))?;
++    let version = SpecializationVersion {
++        major: reader.u32(version_position)?,
++        minor: reader.u32(
++            version_position
++                .checked_add(4)
++                .ok_or_else(|| reader.bad(version_position))?,
++        )?,
++        sub_minor: reader.u32(
++            version_position
++                .checked_add(8)
++                .ok_or_else(|| reader.bad(version_position))?,
++        )?,
++    };
++    if version != SUPPORTED_VERSION {
++        reasons.push(SpecializationConstantsUnsupportedReason::UnsupportedVersion { version });
++    }
++    let generator_value = match root.field(&reader, ROOT_GENERATOR_FIELD, 1)? {
++        Some(position) => reader.u8(position)?,
++        None => GENERATOR_DEFAULT,
++    };
++    let generator = if generator_value == NATIVE_TRANSLATOR {
++        SpecializationGenerator::NativeTranslator
++    } else {
++        reasons.push(
++            SpecializationConstantsUnsupportedReason::UnsupportedGenerator {
++                value: generator_value,
++            },
++        );
++        SpecializationGenerator::Unsupported(generator_value)
++    };
++
++    let descriptor_position = root
++        .field(&reader, ROOT_DESCRIPTOR_FIELD, 4)?
++        .ok_or_else(|| container_error(ContainerError::MissingTag, root.position as u64))?;
++    let descriptor = reader.table(reader.deref(descriptor_position)?)?;
++    let name_position = descriptor
++        .field(&reader, DESCRIPTOR_NAME_FIELD, 4)?
++        .ok_or_else(|| container_error(ContainerError::MissingTag, descriptor.position as u64))?;
++    let descriptor_name_text = reader.string(reader.deref(name_position)?)?;
++    let descriptor_name = name_fingerprint(descriptor_name_text);
++    let name_matches_base = descriptor_name_text == base_name;
++    let name_matches_alias_source = alias_source_name.map(|source| descriptor_name_text == source);
++    if !name_matches_base || name_matches_alias_source == Some(false) {
++        reasons.push(SpecializationConstantsUnsupportedReason::NameMismatch {
++            base_matches: name_matches_base,
++            alias_source_matches: name_matches_alias_source,
++        });
++    }
++
++    let specialized_name = match descriptor.field(&reader, DESCRIPTOR_SPECIALIZED_NAME_FIELD, 4)? {
++        Some(position) => {
++            let text = reader.string(reader.deref(position)?)?;
++            reasons.push(SpecializationConstantsUnsupportedReason::SpecializedNamePresent);
++            Some(name_fingerprint(text))
++        }
++        None => None,
++    };
++
++    let constants = match descriptor.field(&reader, DESCRIPTOR_CONSTANTS_FIELD, 4)? {
++        Some(position) => {
++            let vector = reader.vector(reader.deref(position)?, 4)?;
++            let mut constants = Vec::new();
++            let mut indexes = BTreeSet::new();
++            for element in 0..vector.count {
++                let element_position = usize::try_from(element)
++                    .ok()
++                    .and_then(|element| element.checked_mul(4))
++                    .and_then(|element| vector.first.checked_add(element))
++                    .ok_or_else(|| reader.bad(vector.first))?;
++                let offset = reader.deref(element_position)?;
++                let constant_table = reader.table(offset)?;
++                let index = match constant_table.field(&reader, CONSTANT_INDEX_FIELD, 2)? {
++                    Some(position) => reader.u16(position)?,
++                    None => CONSTANT_INDEX_DEFAULT,
++                };
++                if !indexes.insert(index) {
++                    return Err(reader.bad(constant_table.position));
++                }
++                let discriminator =
++                    match constant_table.field(&reader, CONSTANT_VALUE_TYPE_FIELD, 1)? {
++                        Some(position) => reader.u8(position)?,
++                        None => CONSTANT_UNION_DEFAULT,
++                    };
++                let value = match discriminator {
++                    CONSTANT_INT => {
++                        let position = required_ref(
++                            &reader,
++                            &constant_table,
++                            CONSTANT_VALUE_FIELD,
++                            constant_table.position,
++                        )?;
++                        SpecializationConstantValue::Int(reader.i32(position)?)
++                    }
++                    CONSTANT_BOOL => {
++                        let position = required_ref(
++                            &reader,
++                            &constant_table,
++                            CONSTANT_VALUE_FIELD,
++                            constant_table.position,
++                        )?;
++                        match reader.u8(position)? {
++                            0 => SpecializationConstantValue::Bool(false),
++                            1 => SpecializationConstantValue::Bool(true),
++                            _ => return Err(reader.bad(position)),
++                        }
++                    }
++                    other => {
++                        reasons.push(
++                            SpecializationConstantsUnsupportedReason::UnsupportedUnionValue {
++                                constant_index: index,
++                                discriminator: other,
++                            },
++                        );
++                        continue;
++                    }
++                };
++                constants.push(SpecializationConstant { index, value });
++            }
++            constants
++        }
++        None => Vec::new(),
++    };
++
++    if reasons.is_empty() {
++        Ok(ParsedAirc::Decoded {
++            version,
++            generator,
++            descriptor_name,
++            name_matches_base,
++            name_matches_alias_source,
++            constants,
++        })
++    } else {
++        Ok(ParsedAirc::Unsupported {
++            version: Some(version),
++            generator: Some(generator),
++            descriptor_name: Some(descriptor_name),
++            name_matches_base: Some(name_matches_base),
++            name_matches_alias_source,
++            specialized_name,
++            constants,
++            reasons,
++        })
++    }
++}
++
++fn required_ref(
++    reader: &FlatReader<'_>,
++    table: &FlatTable,
++    field_id: u16,
++    error_at: usize,
++) -> Result<usize, Error> {
++    let field = table
++        .field(reader, field_id, 4)?
++        .ok_or_else(|| container_error(ContainerError::MissingTag, error_at as u64))?;
++    reader.deref(field)
++}
++
++fn name_fingerprint(name: &str) -> SpecializationNameFingerprint {

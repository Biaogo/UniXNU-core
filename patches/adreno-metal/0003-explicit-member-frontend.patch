++        bitcode.extend_from_slice(&row.bitcode);
++        let mut tags = Vec::new();
++        tag(&mut tags, b"NAME", &cstr(&row.name));
++        tag(&mut tags, b"TYPE", &[2]);
++        tag(&mut tags, b"HASH", &sha256(&row.bitcode));

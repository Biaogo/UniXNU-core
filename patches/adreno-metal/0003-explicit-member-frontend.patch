++//! Explicit multi-member selection. Synthetic containers only, plus one env-gated real outer.
++//! Names stay in memory. Reports are counts, ranges, and digests.
++
++use std::collections::BTreeMap;
++use std::path::PathBuf;
++use std::process::Command;
++
++use crate::air::container::sha256;
++use crate::cache::Hash256;
++use crate::error::{ContainerError, Error, Feature, InputErrorKind, Location, MachOOuter};
++use crate::library::{Library, MachOCollection, MemberIdentity};
++
++fn tag(out: &mut Vec<u8>, fourcc: &[u8; 4], bytes: &[u8]) {
++    out.extend_from_slice(fourcc);
++    out.extend_from_slice(&(bytes.len() as u16).to_le_bytes());
++    out.extend_from_slice(bytes);
++}
++
++fn cstr(s: &str) -> Vec<u8> {
++    let mut v = s.as_bytes().to_vec();
++    v.push(0);
++    v
++}
++
++fn wrap(stream: &[u8]) -> Vec<u8> {
++    let mut out = vec![0xDE, 0xC0, 0x17, 0x0B];
++    out.extend_from_slice(&0u32.to_le_bytes());
++    out.extend_from_slice(&20u32.to_le_bytes());
++    out.extend_from_slice(&(stream.len() as u32).to_le_bytes());
++    out.extend_from_slice(&u32::MAX.to_le_bytes());
++    out.extend_from_slice(stream);
++    out
++}
++
++fn kernel(name: &str, seed: u8) -> Vec<u8> {
++    let bitcode = wrap(&[b'B', b'C', 0xC0, 0xDE, seed]);
++    let mut public = Vec::new();
++    let mut private = Vec::new();
++    let md = {
++        let list = b"ENDT".to_vec();
++        let mut out = (list.len() as u32).to_le_bytes().to_vec();
++        out.extend(list);
++        out
++    };
++    let (pub_at, priv_at) = (public.len(), private.len());
++    public.extend(md.clone());
++    private.extend(md);
++    let bc_at = 0usize;
++    let mut list = Vec::new();
++    tag(&mut list, b"NAME", &cstr(name));
++    tag(&mut list, b"TYPE", &[2]);
++    tag(&mut list, b"HASH", &sha256(&bitcode));
++    tag(&mut list, b"MDSZ", &(bitcode.len() as u64).to_le_bytes());
++    let mut offt = Vec::new();
++    for v in [pub_at, priv_at, bc_at] {
++        offt.extend_from_slice(&(v as u64).to_le_bytes());
++    }
++    tag(&mut list, b"OFFT", &offt);
++    tag(&mut list, b"VERS", &[2, 0, 8, 0, 4, 0, 0, 0]);
++    list.extend_from_slice(b"ENDT");
++    let mut entry = ((list.len() + 4) as u32).to_le_bytes().to_vec();
++    entry.extend(list);
++    let entries_len = entry.len();
++    let list_off = 0x58usize;
++    let pub_off = list_off + 4 + entries_len + 4;
++    let priv_off = pub_off + public.len();
++    let bc_off = priv_off + private.len();
++    let file_size = bc_off + bitcode.len();
++    let mut out = Vec::new();
++    out.extend_from_slice(b"MTLB");
++    out.extend_from_slice(&0x8001u16.to_le_bytes());
++    out.extend_from_slice(&2u16.to_le_bytes());
++    out.extend_from_slice(&9u16.to_le_bytes());
++    out.push(0);
++    out.push(0x81);
++    out.extend_from_slice(&26u16.to_le_bytes());
++    out.extend_from_slice(&0u16.to_le_bytes());
++    for v in [
++        file_size,
++        list_off,

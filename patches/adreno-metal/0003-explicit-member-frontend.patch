++fn patch_spci(bytes: &mut [u8], offset: u64) {
++    let at = bytes.windows(4).position(|w| w == b"SPCI").expect("SPCI") + 6 + 1 + 32;
++    bytes[at..at + 8].copy_from_slice(&offset.to_le_bytes());
++}

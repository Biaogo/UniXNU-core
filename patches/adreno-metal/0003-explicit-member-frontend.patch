++    w.u32(root + 4, 0);
++    w.u32(root + 8, 1);
++    w.u32(root + 12, 0);
++    w.u8(root + 16, 1);
++    let descriptor = w.table(&[(0, 4), (2, 12)], 16);
++    let vector = w.offsets(0);
++    let name_at = w.string(name);

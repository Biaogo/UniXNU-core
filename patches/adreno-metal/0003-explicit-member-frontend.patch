++fn slst(script: &[u8], section_at: usize) -> Vec<u8> {
++    let mut out = 1u32.to_le_bytes().to_vec();
++    let group_at = section_at + 4;
++    let payload_at = group_at + 12;
++    let pad = (16 - payload_at % 16) % 16;
++    let payload_size = pad + script.len();
++    let group_size = payload_size + 16;
++    out.extend_from_slice(&(group_size as u32).to_le_bytes());
++    out.extend_from_slice(b"SBUF");
++    out.extend_from_slice(&(payload_size as u32).to_le_bytes());
++    out.extend(std::iter::repeat_n(0, pad));
++    out.extend_from_slice(script);
++    out.extend_from_slice(b"ENDT");
++    out
++}

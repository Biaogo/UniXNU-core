++//! Single-outer identity, strict alias ownership, and opaque SPCI cache identity.
++
++use crate::air::container::sha256;
++use crate::device::requirements::VkFeature;
++use crate::device::{Device, DeviceDescription, DevicePolicy};
++use crate::error::{AbiError, Error, Feature, InputErrorKind, MachOOuter};

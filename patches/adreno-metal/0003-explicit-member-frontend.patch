++fn slst_group_offset(bytes: &[u8]) -> u64 {
++    let lib = crate::air::container::parse(bytes)
++        .expect("metallib")
++        .metallib()
++        .expect("mtlb");
++    let tag = lib
++        .extended
++        .iter()
++        .find(|tag| &tag.fourcc == b"SLST")
++        .expect("SLST");
++    let at = u64::from_le_bytes(tag.bytes[..8].try_into().unwrap()) as usize;
++    (4u64) // group starts after the count word, relative to the section
++        .checked_add(0)
++        .unwrap_or(0);
++    let _ = at;
++    4
++}

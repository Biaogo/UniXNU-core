++#[test]
++fn single_gpu_macho_keeps_outer_bytes_and_refuses_a_second_library() {
++    let inner = build(&[named(wrap(&air(false)), Vec::new())]);
++    let mut payload = inner.clone();
++    payload.extend_from_slice(&[0; 8]);
++    let outer = macho(&payload, 0x0100_0013, 2);
++    let library = Library::from_metallib(&outer).expect("one MTLB outer");
++    assert_eq!(library.bytes(), outer.as_slice());
++    assert_eq!(library.content_hash(), &sha256(&outer));
++    assert_ne!(library.content_hash(), &sha256(&inner));
++    let function = library.function("alias_source").expect("inner function");
++    assert_eq!(
++        function.bitcode().expect("bitcode"),
++        wrap(&air(false)).as_slice()
++    );
++
++    let mut two = inner.clone();
++    two.extend_from_slice(&inner);
++    let err = Library::from_metallib(&macho(&two, 0x0100_0013, 2)).expect_err("two MTLBs");
++    match err {
++        crate::error::Error::Unsupported(refusal) => assert_eq!(
++            refusal.feature,
++            Feature::MachOOuter(MachOOuter::LibraryCount(2))
++        ),
++        other => {
++            panic!("multi MTLB must stay a typed count refusal, not a selected library: {other:?}")
++        }
++    }
++    let counted = {
++        let mut bytes = 4u32.to_le_bytes().to_vec();
++        bytes.extend_from_slice(&inner);
++        bytes
++    };
++    assert!(
++        Library::from_metallib(&counted).is_err(),
++        "counted prefix stays rejected"
++    );
++}

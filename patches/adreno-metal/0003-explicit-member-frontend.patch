++fn bound_library(script: &[u8]) -> (Vec<u8>, String, String) {
++    let base_name = "base_kernel".to_owned();
++    let own_name = "own_kernel".to_owned();
++    let base = kernel(&base_name, false);
++    let own = kernel(&own_name, true);
++    let bytes = library(
++        &[
++            FnRow {
++                name: base_name.clone(),
++                bitcode: base.clone(),
++                extra: Vec::new(),
++                public_tags: Vec::new(),

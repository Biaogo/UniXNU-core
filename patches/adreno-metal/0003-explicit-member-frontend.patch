++/// A dynamic MTLB (`file_type` 2) with one module and an `HDYN` `NAME`.
++/// Fake bitcode parses; it is not lowered.
++fn dynamic_member(install: &str, seed: u8) -> Vec<u8> {
++    let bitcode = wrap(&[b'B', b'C', 0xC0, 0xDE, seed]);
++    let mut public = Vec::new();
++    let mut private = Vec::new();
++    let md = {
++        let list = b"ENDT".to_vec();
++        let mut out = (list.len() as u32).to_le_bytes().to_vec();
++        out.extend(list);
++        out
++    };
++    public.extend(md.clone());
++    private.extend(md);
++    let mut list = Vec::new();
++    tag(&mut list, b"NAME", &cstr("export"));
++    tag(&mut list, b"TYPE", &[3]);
++    tag(&mut list, b"HASH", &sha256(&bitcode));
++    tag(&mut list, b"MDSZ", &(bitcode.len() as u64).to_le_bytes());
++    let mut offt = Vec::new();
++    for v in [0u64, 0, 0] {
++        offt.extend_from_slice(&v.to_le_bytes());
++    }
++    tag(&mut list, b"OFFT", &offt);
++    tag(&mut list, b"VERS", &[2, 0, 8, 0, 4, 0, 0, 0]);
++    list.extend_from_slice(b"ENDT");
++    let mut entry = ((list.len() + 4) as u32).to_le_bytes().to_vec();
++    entry.extend(list);
++    let entries_len = entry.len();
++    let mut region = Vec::new();
++    tag(&mut region, b"NAME", &cstr(install));
++    region.extend_from_slice(b"ENDT");
++    let list_off = 0x58usize;
++    let pub_off = list_off + 4 + entries_len + 4 + 22;
++    let priv_off = pub_off + public.len();
++    let bc_off = priv_off + private.len();
++    let region_at = bc_off + bitcode.len();
++    let file_size = region_at + region.len();
++    let mut pointed = (region_at as u64).to_le_bytes().to_vec();
++    pointed.extend_from_slice(&(region.len() as u64).to_le_bytes());
++    let mut ext = Vec::new();
++    tag(&mut ext, b"HDYN", &pointed);
++    ext.extend_from_slice(b"ENDT");
++    assert_eq!(ext.len(), 26);
++    let mut out = Vec::new();
++    out.extend_from_slice(b"MTLB");
++    out.extend_from_slice(&0x8001u16.to_le_bytes());
++    out.extend_from_slice(&2u16.to_le_bytes());
++    out.extend_from_slice(&9u16.to_le_bytes());
++    out.push(2);
++    out.push(0x81);
++    out.extend_from_slice(&26u16.to_le_bytes());
++    out.extend_from_slice(&0u16.to_le_bytes());
++    for v in [
++        file_size,
++        list_off,
++        entries_len,
++        pub_off,
++        public.len(),
++        priv_off,
++        private.len(),
++        bc_off,
++        bitcode.len(),
++    ] {
++        out.extend_from_slice(&(v as u64).to_le_bytes());
++    }
++    assert_eq!(out.len(), 0x58);
++    out.extend_from_slice(&1u32.to_le_bytes());
++    out.extend(entry);
++    out.extend(ext);
++    out.extend(public);
++    out.extend(private);
++    out.extend(bitcode);
++    out.extend(region);
++    assert_eq!(out.len(), file_size);
++    out
++}

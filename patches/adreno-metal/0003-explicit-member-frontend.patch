++    /// This reads [`SpecializationScript::bytes`] and compares the script's descriptor name with
++    /// the named base and, for an alias, its source entry. It does not apply the values to AIR,
++    /// compile a pipeline, or make any function with `SPCI` supported for compilation.
++    ///
++    /// The supported form is `Air.ConstantsSpecializationScript` version 0.1.0 from the
++    /// `NativeTranslator` generator, with absent `specialized_name`, and i32 or bool constants.
++    /// Any other established form is [`SpecializationConstants::Unsupported`]; malformed bytes
++    /// are the container reader's typed [`Error`]. The binding remains the alias's own binding:
++    /// this query neither selects nor substitutes the base's bitcode. Forms that did not become a
++    /// binding remain in [`SpecializationBindings::unresolved`] and are not silently decoded here.
++    pub fn airc_constants(&self) -> Result<SpecializationConstants<'a>, Error> {

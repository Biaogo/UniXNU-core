++fn semantic_words(words: &[u32]) -> Vec<u32> {
++    let mut out = words.get(..5).unwrap_or(words).to_vec();
++    let mut i = 5usize;
++    while i < words.len() {
++        let head = words[i];
++        let count = (head >> 16) as usize;
++        let op = head & 0xffff;
++        if count == 0 || i + count > words.len() {
++            break;
++        }
++        let inst = &words[i..i + count];
++        match op {
++            2 | 3 | 4 | 5 | 6 | 7 | 8 => {}
++            15 => out.extend(canonical_entry(inst)),
++            _ => out.extend_from_slice(inst),
++        }
++        i += count;
++    }
++    out
++}
++
++fn canonical_entry(inst: &[u32]) -> Vec<u32> {
++    let mut out = inst.to_vec();
++    let mut at = 3usize;
++    while at < out.len() {
++        let word = out[at];
++        out[at] = 0;
++        at += 1;
++        if word.to_le_bytes().contains(&0) {
++            break;
++        }
++    }
++    out
++}
++
++fn compile_words(
++    function: crate::library::Function,
++    constants: FunctionConstantValues,
++) -> Vec<u32> {
++    let mut fd = FunctionDescriptor::new(function);
++    fd.constants = constants;
++    let compiled = device()
++        .compile_function(&fd, &LoweringInputs::default(), &Budget::standard())
++        .expect("compile");
++    compiled.artifact().module.words.clone()
++}

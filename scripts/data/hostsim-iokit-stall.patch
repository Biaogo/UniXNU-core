 static bool trace(){static int t=-1;if(t<0)t=getenv("HOSTSIM_TRACE")?1:0;return t;}
 
+static uint64_t hostsimMonotonicNs(const timespec &value) {
+    return static_cast<uint64_t>(value.tv_sec) * 1000000000ull + static_cast<uint64_t>(value.tv_nsec);
+}
+
+/* Keep the first BoAlloc blocked for a monotonic deadline. A signal may interrupt sleep(), so log each return and retry for the
+ * unslept duration instead of consuming the one-shot injection early. */
+static bool hostsimStall(uint32_t method, const char *route) {
+    if (method != 2) return false;
+    const char *value = getenv("HOSTSIM_STALL");
+    if (!value || !*value) return false;
+    for (const char *digit = value; *digit; ++digit) {
+        if (*digit < '0' || *digit > '9') {
+            fprintf(stderr,"shim: stall method=%u route=%s requested=%s rejected\n",method,route,value);
+            return false;
+        }
+    }
+    char *end = nullptr;
+    errno = 0;
+    const unsigned long requested = strtoul(value,&end,10);
+    if (errno || end == value || *end || !requested || requested > 0xfffffffful) {
+        fprintf(stderr,"shim: stall method=%u route=%s requested=%s rejected\n",method,route,value);
+        return false;
+    }
+    static std::atomic<bool> claimed(false);
+    if (claimed.exchange(true,std::memory_order_acq_rel)) return false;
+
+    timespec start = {};
+    if (clock_gettime(CLOCK_MONOTONIC,&start)) {
+        fprintf(stderr,"shim: stall method=%u route=%s requested_ms=%llu result=clock_error\n",
+                method,route,(unsigned long long)requested * 1000ull);
+        return false;
+    }
+    const uint64_t requestedMs = static_cast<uint64_t>(requested) * 1000ull;
+    const uint64_t deadline = hostsimMonotonicNs(start) + requestedMs * 1000000ull;
+    fprintf(stderr,"shim: stall method=%u route=%s requested_ms=%llu result=begin\n",method,route,
+            (unsigned long long)requestedMs);
+    unsigned attempts = 0, interrupts = 0;
+    for (;;) {
+        timespec now = {};
+        if (clock_gettime(CLOCK_MONOTONIC,&now)) {
+            fprintf(stderr,"shim: stall method=%u route=%s requested_ms=%llu result=clock_error\n",
+                    method,route,(unsigned long long)requestedMs);
+            return false;
+        }
+        const uint64_t nowNs = hostsimMonotonicNs(now);
+        if (nowNs >= deadline) break;
+        const uint64_t remainingNs = deadline - nowNs;
+        const unsigned seconds = static_cast<unsigned>((remainingNs + 999999999ull) / 1000000000ull);
+        errno = 0;
+        const unsigned left = sleep(seconds);
+        const int sleepError = errno;
+        timespec after = {};
+        if (clock_gettime(CLOCK_MONOTONIC,&after)) {
+            fprintf(stderr,"shim: stall method=%u route=%s requested_ms=%llu result=clock_error\n",
+                    method,route,(unsigned long long)requestedMs);
+            return false;
+        }
+        const uint64_t elapsedMs = (hostsimMonotonicNs(after) - hostsimMonotonicNs(start)) / 1000000ull;
+        ++attempts;
+        if (left || sleepError == EINTR) ++interrupts;
+        fprintf(stderr,"shim: stall method=%u route=%s attempt=%u requested_ms=%llu returned_s=%u errno=%d (%s) "
+                "interrupted=%u elapsed_ms=%llu\n",method,route,attempts,(unsigned long long)requestedMs,left,
+                sleepError,strerror(sleepError),left || sleepError == EINTR ? 1u : 0u,(unsigned long long)elapsedMs);
+    }
+    timespec finish = {};
+    if (clock_gettime(CLOCK_MONOTONIC,&finish)) return false;
+    const uint64_t elapsedMs = (hostsimMonotonicNs(finish) - hostsimMonotonicNs(start)) / 1000000ull;
+    fprintf(stderr,"shim: stall method=%u route=%s requested_ms=%llu interrupts=%u result=complete elapsed_ms=%llu\n",
+            method,route,(unsigned long long)requestedMs,interrupts,(unsigned long long)elapsedMs);
+    return true;
+}
